MYSQL_DATABASE=vault_multistore
MYSQL_USER=vault_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

DB_HOST=mysql
DB_PORT=3306
BACKEND_PORT=3000

# Secret used to sign customer/admin login sessions (JWT). Generate your own, e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change_me_to_a_long_random_string

# External Stock Product APIs
DOOR_API_URL=http://119.59.102.161:3117/api/products
BRANDNAME_API_URL=http://119.59.102.161:3063/api/products
PLUG_API_URL=http://119.59.102.161:3038/api/products
CLOTHING_API_URL=http://119.59.102.161:3026/api/products
POWERBANK_API_URL=http://119.59.102.161:3020/api/products
PROJECTOR_API_URL=http://119.59.102.161:3005/api/products

# Gemini API key for the customer-facing AI features (search, chat, recommendations,
# descriptions). Leave blank to run without AI — /api/ai/* then responds with 503
# instead of crashing the app. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
